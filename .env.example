# INVOICEAI Enterprise Environment Configuration

# Server Port
PORT=5000

# JWT Authentication Secret
JWT_SECRET=invoiceai-super-secret-jwt-key-2026

# MongoDB Connection String (leave empty to automatically run in-memory MongoDB)
MONGODB_URI=

# Google Gemini API Key (for multimodal purchase order extraction)
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=

# CORS Origin for Web Client
CORS_ORIGIN=http://localhost:3000
