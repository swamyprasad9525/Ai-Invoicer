# INVOICEAI Enterprise Environment Configuration
# Copy this file to .env and fill in the values.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT Authentication ────────────────────────────────────────────────────────
# Replace with a long random string in production
JWT_SECRET=invoiceai-super-secret-jwt-key-change-in-production

# ─── Database ──────────────────────────────────────────────────────────────────
# Leave empty to auto-start a local in-memory MongoDB (development only)
# Set to your MongoDB Atlas URI for persistent storage
MONGODB_URI=

# ─── AI Extraction ─────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/
# Leave empty to use the deterministic pilot mock extractor
GEMINI_API_KEY=

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Chunk 2: Background Job Queue ────────────────────────────────────────────
# Leave empty to use the built-in in-process fallback queue (no Redis needed)
# Set to redis://localhost:6379 for BullMQ-backed persistent queues
REDIS_URL=

# ─── Chunk 2: Document Storage ────────────────────────────────────────────────
# Leave empty to store files on local disk under apps/api/uploads/ (default)
# Set bucket + region for AWS S3 or S3-compatible storage (MinIO, Cloudflare R2)
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For MinIO or S3-compatible services (leave empty for real AWS S3)
AWS_ENDPOINT_URL=
